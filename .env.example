AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=ezassist_2_0_0_2_dev
AZURE_SQL_USER=replace_with_database_user
AZURE_SQL_PASSWORD=replace_with_database_password
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false
DATABASE_URL=sqlserver://your-server.database.windows.net:1433;database=ezassist_2_0_0_2_dev;user=replace_with_database_user;password=replace_with_database_password;encrypt=true;trustServerCertificate=false

OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
GUEST_SESSION_SECRET=replace_with_at_least_32_random_characters

# Set false to use the SQL Server-backed API.
NEXT_PUBLIC_DEMO_MODE=true
