{
  "name": "worker-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:check": "node scripts/check-schema.mjs",
    "db:deploy": "node scripts/deploy-schema.mjs",
    "readiness": "node scripts/check-readiness.mjs",
    "acceptance:matrix": "node scripts/check-acceptance-matrix.mjs",
    "acceptance": "npm run acceptance:matrix && npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "setup:local": "node scripts/setup-local-env.mjs D:/backend/web/config.js"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^18.0.4",
    "mssql": "^12.7.2",
    "next": "16.3.7",
    "openai": "^7.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
